# apex-physio.ca only (added Sep 30, 2026).
# Makes browsers check for a newer version of pages, styles and scripts,
# so site updates show up right away instead of an old saved copy.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|css|js|json|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.glb$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# 3D muscle model file type
AddType model/gltf-binary .glb